# copy to terraform.tfvars and edit - terraform.tfvars itself is gitignored
# credentials are NEVER put in here, they come from the environment:
#   export AWS_ACCESS_KEY_ID=...
#   export AWS_SECRET_ACCESS_KEY=...
# or better, from an IAM role / aws sso login

aws_region         = "ap-south-1"
environment        = "dev"
cluster_name       = "bookshelf-eks"
node_instance_type = "t3.medium"
node_desired_size  = 2
